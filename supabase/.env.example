############
# Postgres
############
POSTGRES_PASSWORD=postgres-local-password
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# JWT - gerados para desenvolvimento local
# NUNCA usar estes valores em producao
############
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

ANON_KEY=anon-key-for-development
SERVICE_ROLE_KEY=service-role-key-for-development

SUPABASE_PUBLISHABLE_KEY=publishable-key-for-development
SUPABASE_SECRET_KEY=secret-key-for-development
JWT_KEYS=jwt-keys-for-development
JWT_JWKS=jwt-jwks-for-development

############
# Dashboard
############
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase-local

############
# Supavisor
############
SECRET_KEY_BASE=secret-key-base-for-development
VAULT_ENC_KEY=vault-enc-key-for-development
PG_META_CRYPTO_KEY=pg-meta-crypto-key-for-development
POOLER_TENANT_ID=pooler-tenant-id-for-development
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543

############
# Analytics
############
LOGFLARE_PUBLIC_ACCESS_TOKEN=logflare-public-access-token-for-development
LOGFLARE_PRIVATE_ACCESS_TOKEN=logflare-private-access-token-for-development
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=google-project-id-for-development
GOOGLE_PROJECT_NUMBER=google-project-number-for-development

############
# URLs
############
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000

############
# Storage S3
############
S3_PROTOCOL_ACCESS_KEY_ID=s3-protocol-access-key-id-for-development
S3_PROTOCOL_ACCESS_KEY_SECRET=s3-protocol-access-key-secret-for-development
GLOBAL_S3_BUCKET=global-s3-bucket-for-development
REGION=local
STORAGE_TENANT_ID=storage-tenant-id-for-development
MINIO_ROOT_USER=minio-root-user-for-development
MINIO_ROOT_PASSWORD=minio-root-password-for-development

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=studio-default-organization-for-development
STUDIO_DEFAULT_PROJECT=studio-default-project-for-development
OPENAI_API_KEY=openai-api-key-for-development

############
# Auth
############
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@localhost
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Coulson
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# API Gateway
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy
############
IMGPROXY_AUTO_WEBP=true
