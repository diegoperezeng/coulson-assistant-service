      "parameters": {
        "jsCode": "const segments = $input.first().json.body.segments;\nlet speakersList =[];\n\nfor (const segment of segments) {\n  if(segment.speaker!=\"@\"){\n    speakersList.push(segment.speaker);\n  }\n}\n\nconst speakersSet = new Set(speakersList);\n\nreturn Array.from(speakersSet, (speaker) => ({ speaker }));;"
