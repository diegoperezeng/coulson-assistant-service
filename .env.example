WEBHOOK_BASE_URL=http://n8n:5678
WEBHOOK_TRANSCRIBE_PATH=/webhook/transcribe
WEBHOOK_SPEAKERS_PATH=/webhook/speakers
WEBHOOK_TOKEN=80797061-413c-47cf-a60c-bcc43a23d703
WEBHOOK_CONNECT_TIMEOUT=30
WEBHOOK_READ_TIMEOUT=300
WEBHOOK_TRANSCRIPTION_PARALLELISM=8
VIDEO_MAX_CHUNK_SIZE_MB=200
VIDEO_MAX_AUDIO_CHUNK_SECONDS=400
FFMPEG_AUDIO_SAMPLE_RATE=16000
FFMPEG_AUDIO_CHANNELS=1
FFMPEG_AUDIO_BITRATE=32k

# Supabase local (docker): jdbc:postgresql://supabase-db:5432/postgres
# Supabase cloud: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://supabase-db:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=postgres-local-password

# Supabase - obtenha em https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage S3 - obtenha em https://supabase.com/dashboard/project/<ref>/storage/buckets
SUPABASE_STORAGE_BUCKET=meetings
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_VOICE_SAMPLES_BUCKET=voice-samples

# OpenAI - obtenha em https://platform.openai.com/api-keys
# Deixe em branco e mantenha OPENAI_EMBEDDING_ENABLED=false para desabilitar a geracao de embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_ENABLED=false
